<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".ControlHerbalApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ControlHerbal">

        <activity
            android:name=".frontend.activities.main.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.ControlHerbal">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Consentimiento y documentos legales (no exportadas) -->
        <activity android:name=".frontend.activities.privacy.ConsentActivity" android:exported="false" android:theme="@style/Theme.ControlHerbal" />
        <activity android:name=".frontend.activities.privacy.LegalActivity" android:exported="false" android:theme="@style/Theme.ControlHerbal" />
        <activity android:name=".frontend.activities.privacy.PrivacyActivity" android:exported="false" android:theme="@style/Theme.ControlHerbal" />

        <!-- Acceso con cuenta autorizada (no exportada: solo se abre desde la propia app) -->
        <activity
            android:name=".frontend.activities.auth.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.ControlHerbal" />

        <activity
            android:name=".frontend.activities.auth.MfaEnrollActivity"
            android:exported="false"
            android:theme="@style/Theme.ControlHerbal" />

        <activity
            android:name=".frontend.activities.auth.ChangePasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.ControlHerbal" />

        <!-- Actividades internas no exportadas para prevenir Intent Redirection -->
        <activity
            android:name=".frontend.activities.main.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.ControlHerbal"
            android:launchMode="singleTop" />

        <activity
            android:name=".frontend.activities.main.SectionHostActivity"
            android:exported="false"
            android:theme="@style/Theme.ControlHerbal"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".frontend.activities.plant.HistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.ControlHerbal"
            android:label="Historial de Sensores"
            android:parentActivityName=".frontend.activities.main.SectionHostActivity" />

        <activity
            android:name=".frontend.activities.plant.PlantSetupActivity"
            android:exported="false"
            android:theme="@style/Theme.ControlHerbal"
            android:label="Configuración de Planta" />

        <activity
            android:name=".frontend.activities.plant.ComparisonActivity"
            android:exported="false"
            android:theme="@style/Theme.ControlHerbal"
            android:label="Comparador de Plantas"
            android:parentActivityName=".frontend.activities.main.SectionHostActivity" />

        <activity
            android:name=".frontend.activities.plant.ChatActivity"
            android:exported="false"
            android:theme="@style/Theme.ControlHerbal"
            android:label="Asistente Herbal AI"
            android:parentActivityName=".frontend.activities.main.SectionHostActivity" />

        <activity
            android:name=".frontend.activities.plant.AnimatedDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.ControlHerbal"
            android:label="Dashboard Dinámico"
            android:parentActivityName=".frontend.activities.main.SectionHostActivity" />

        <activity
            android:name=".frontend.activities.plant.CalendarActivity"
            android:exported="false"
            android:theme="@style/Theme.ControlHerbal"
            android:label="Calendario de Cuidado"
            android:parentActivityName=".frontend.activities.main.MainActivity" />

        <activity
            android:name=".frontend.activities.plant.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.ControlHerbal"
            android:label="Configuración"
            android:parentActivityName=".frontend.activities.main.SectionHostActivity" />

        <activity
            android:name=".frontend.activities.plant.AccessibilityActivity"
            android:exported="false"
            android:theme="@style/Theme.ControlHerbal"
            android:label="Accesibilidad"
            android:parentActivityName=".frontend.activities.main.SectionHostActivity" />

        <activity
            android:name=".frontend.activities.privacy.TermsDocumentsActivity"
            android:exported="false"
            android:theme="@style/Theme.ControlHerbal"
            android:label="Términos y documentos"
            android:parentActivityName=".frontend.activities.main.SectionHostActivity" />

        <activity
            android:name=".frontend.activities.privacy.UserProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.ControlHerbal"
            android:label="Mi perfil"
            android:parentActivityName=".frontend.activities.main.SectionHostActivity" />

        <!-- Receivers para Widgets de Pantalla de Inicio -->
        <receiver
            android:name=".frontend.widget.HerbalWidgetSummaryReceiver"
            android:exported="true"
            android:label="Resumen Herbal">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/herbal_widget_info" />
        </receiver>

    </application>

</manifest>
