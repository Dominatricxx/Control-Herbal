<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.controlherbal">

    <!-- Permisos de red, sensores y notificaciones -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ControlHerbal"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <!-- Servicio de monitoreo en segundo plano -->
        <service
            android:name=".data.sync.SensorForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Punto de entrada principal (Launcher) -->
        <activity
            android:name=".ui.activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.ControlHerbal">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Actividades internas no exportadas para prevenir Intent Redirection -->
        <activity
            android:name=".ui.activities.MainActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".ui.activities.HistoryActivity"
            android:exported="false"
            android:label="Historial de Sensores"
            android:parentActivityName=".ui.activities.MainActivity" />

        <activity
            android:name=".ui.activities.PlantSetupActivity"
            android:exported="false"
            android:label="Configuración de Planta" />

        <activity
            android:name=".ui.activities.ComparisonActivity"
            android:exported="false"
            android:label="Comparador de Plantas"
            android:parentActivityName=".ui.activities.MainActivity" />

        <activity
            android:name=".ui.activities.ChatActivity"
            android:exported="false"
            android:label="Asistente Herbal AI"
            android:parentActivityName=".ui.activities.MainActivity" />

        <!-- Receivers para Widgets de Pantalla de Inicio -->
        <receiver
            android:name=".ui.widget.HerbalWidgetSummaryReceiver"
            android:exported="true"
            android:label="Resumen Herbal">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/herbal_widget_summary_info" />
        </receiver>

        <receiver
            android:name=".ui.widget.HerbalWidgetStatusReceiver"
            android:exported="true"
            android:label="Estado Herbal">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/herbal_widget_status_info" />
        </receiver>

        <receiver
            android:name=".ui.widget.HerbalWidgetAlertReceiver"
            android:exported="true"
            android:label="Alerta Herbal (Mini)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/herbal_widget_alert_info" />
        </receiver>

        <!-- FileProvider Seguro -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
