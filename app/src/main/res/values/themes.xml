<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ControlHerbal" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/green_herbal</item>
        <item name="colorPrimaryVariant">@color/green_herbal_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">#81C784</item>
        <item name="colorSecondaryVariant">#4CAF50</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Global Rounded Dialogs and Popups -->
        <item name="materialAlertDialogTheme">@style/RoundedMaterialAlertDialog</item>
        <item name="alertDialogTheme">@style/RoundedMaterialAlertDialog</item>
        <item name="popupMenuStyle">@style/RoundedPopupMenu</item>
        <item name="android:listPopupWindowStyle">@style/RoundedListPopupWindow</item>
        <item name="listPopupWindowStyle">@style/RoundedListPopupWindow</item>
        <item name="android:windowAnimationStyle">@style/CustomWindowAnimation</item>
    </style>

    <style name="CustomWindowAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="RoundedMaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.ControlHerbal.Dialog.Rounded</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="ShapeAppearanceOverlay.ControlHerbal.Dialog.Rounded" parent="">
        <item name="cornerSize">28dp</item>
    </style>

    <style name="RoundedPopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/spinner_dropdown_background</item>
    </style>

    <style name="RoundedListPopupWindow" parent="Widget.AppCompat.ListPopupWindow">
        <item name="android:popupBackground">@drawable/spinner_dropdown_background</item>
    </style>
</resources>