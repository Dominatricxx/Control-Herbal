<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingTop="64dp"
    android:paddingBottom="40dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:background="#121212">

    <!-- Contenedor tipo carta respetando los límites superior e inferior -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#2B2B2D"
        app:cardCornerRadius="28dp"
        app:cardElevation="10dp"
        app:strokeColor="#3A3A3C"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_revert"
                    android:contentDescription="Volver"
                    app:tint="#81C784" />

            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agregar planta"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="24dp"
                android:gravity="center" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/plant_name_hint"
                app:boxBackgroundColor="#5E5E60"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="#81C784"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="@color/hint_color_selector"
                android:layout_marginBottom="24dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPlantName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:textColor="#FFFFFF"
                    android:textColorHint="@color/hint_color_selector"
                    android:maxLength="50" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/plant_type_label"
                app:boxBackgroundColor="#5E5E60"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="#81C784"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="@color/hint_color_selector"
                android:layout_marginBottom="24dp">

                <AutoCompleteTextView
                    android:id="@+id/spinnerPlantType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="#FFFFFF"
                    android:textColorHint="@color/hint_color_selector"
                    android:popupBackground="@drawable/spinner_dropdown_background" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Nombre científico debajo del tipo seleccionado -->
            <TextView
                android:id="@+id/tvScientificName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="italic"
                android:textColor="#A5D6A7"
                android:gravity="start"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_marginBottom="24dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnSelectSpecificPlant"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="24dp"
                android:text="Seleccionar Planta"
                android:visibility="gone"
                android:backgroundTint="#5E5E60"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:cornerRadius="14dp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/environment_label"
                app:boxBackgroundColor="#5E5E60"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="#81C784"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="@color/hint_color_selector"
                android:layout_marginBottom="28dp">

                <AutoCompleteTextView
                    android:id="@+id/spinnerEnvironment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="#FFFFFF"
                    android:textColorHint="@color/hint_color_selector"
                    android:popupBackground="@drawable/spinner_dropdown_background" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnSavePlant"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#2E7D32"
                android:text="@string/btn_start_care"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</ScrollView>
