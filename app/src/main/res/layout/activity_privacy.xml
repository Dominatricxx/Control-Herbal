<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPrivacyBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#212121" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:paddingStart="8dp"
                android:text="@string/privacy_title"
                android:textColor="#1B5E20"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAcceptedInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#424242"
            android:textSize="14sp" />

        <!-- Documentos -->
        <TextView
            style="@style/PrivacySectionHeader"
            android:text="@string/privacy_docs_header" />
        <Button android:id="@+id/btnDocPrivacy" style="@style/PrivacyButton" android:text="@string/consent_read_privacy" />
        <Button android:id="@+id/btnDocTerms" style="@style/PrivacyButton" android:text="@string/consent_read_terms" />
        <Button android:id="@+id/btnDocCookies" style="@style/PrivacyButton" android:text="@string/consent_read_cookies" />
        <Button android:id="@+id/btnDocConsents" style="@style/PrivacyButton" android:text="Ver el Registro de Consentimientos" />

        <!-- IA -->
        <TextView
            style="@style/PrivacySectionHeader"
            android:text="@string/privacy_ai_header" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchAi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/privacy_ai_switch"
            android:textColor="#212121"
            android:textSize="16sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_ai_hint"
            android:textColor="#424242"
            android:textSize="14sp" />

        <!-- Paleta -->
        <TextView
            style="@style/PrivacySectionHeader"
            android:text="@string/privacy_palette_header" />
        <RadioGroup
            android:id="@+id/rgPalette"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
        <LinearLayout
            android:id="@+id/palettePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:importantForAccessibility="no">
            <TextView android:id="@+id/previewOk" style="@style/PrivacyChip" />
            <TextView android:id="@+id/previewWarn" style="@style/PrivacyChip" />
            <TextView android:id="@+id/previewCritical" style="@style/PrivacyChip" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/privacy_palette_hint"
            android:textColor="#424242"
            android:textSize="14sp" />

        <!-- Datos -->
        <TextView
            style="@style/PrivacySectionHeader"
            android:text="@string/privacy_data_header" />
        <Button android:id="@+id/btnExport" style="@style/PrivacyButton" android:text="@string/privacy_export" />
        <Button android:id="@+id/btnWipe" style="@style/PrivacyButton" android:text="@string/privacy_wipe" />
        <Button
            android:id="@+id/btnDeleteAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#C62828"
            android:text="@string/privacy_delete_account"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>
