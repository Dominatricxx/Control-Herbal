<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070A12">

    <!-- 1. Capa inferior: Fondo dinámico animado -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBackgroundView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Capa superior: Contenedores flotantes con márgenes externos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:clipChildren="false">

        <!-- Contenedor Superior Estático -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Encabezado personalizado -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/btnMenu"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Abrir menú"
                        android:src="@android:drawable/ic_menu_sort_by_size"
                        app:tint="#2E7D32" />

                    <TextView
                        android:id="@+id/tvHeaderTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/btnMenu"
                        android:layout_marginStart="8dp"
                        android:layout_centerVertical="true"
                        android:text="Historial"
                        android:textColor="#2E7D32"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:layout_alignParentEnd="true"
                        android:contentDescription="Logo"
                        android:src="@mipmap/ic_launcher_round" />
                </RelativeLayout>

                <!-- Contenido -->
                <include layout="@layout/activity_history" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 3. Barra de navegación inferior flotante con efecto Gooey (Compose) -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/composeBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/nav_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
