<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070A12">

    <!-- 1. Capa inferior: Fondo dinámico animado (cubre toda la pantalla edge-to-edge) -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBackgroundView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Capa superior: Contenedores flotantes con márgenes externos generosos arriba y abajo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="40dp"
        android:clipToPadding="false"
        android:clipChildren="false">

        <!-- Contenedor Superior (Tamaño estático con scroll interno, separado de los bordes superior e inferior) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFFFFF">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <!-- Título y encabezado -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <ImageButton
                            android:id="@+id/btnMenu"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Abrir menú"
                            android:src="@android:drawable/ic_menu_sort_by_size"
                            app:tint="#2E7D32" />

                        <TextView
                            android:id="@+id/tvMainTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="8dp"
                            android:layout_toEndOf="@id/btnMenu"
                            android:text="Control Herbal"
                            android:textColor="#2E7D32"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnAddPlant"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_toStartOf="@id/ivLogo"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="8dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/ic_input_add"
                            app:tint="#2E7D32"
                            android:contentDescription="Añadir otra planta" />

                        <ImageView
                            android:id="@+id/ivLogo"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:layout_alignParentEnd="true"
                            android:contentDescription="Logo"
                            android:src="@mipmap/ic_launcher_round" />
                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/layoutPlantInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp"
                        android:gravity="center"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvPlantNameAndEmoji"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mi Planta"
                                android:textSize="18sp"
                                android:textColor="#2E7D32"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:clickable="true"
                                android:focusable="true"
                                android:background="?attr/selectableItemBackground"/>

                            <ImageButton
                                android:id="@+id/btnEditNameIcon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="8dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@android:drawable/ic_menu_edit"
                                app:tint="#2E7D32"
                                android:visibility="gone"
                                android:contentDescription="Editar nombre" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Tarjeta de Diagnóstico IA -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardAiDiagnosis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="#FFF3E0"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Diagnóstico Herbal AI"
                                android:textColor="#E65100"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvAiDiagnosisTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Problema detectado"
                                android:textColor="#212121"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvAiDiagnosisBody"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Descripción..."
                                android:textColor="#424242"
                                android:textSize="14sp" />

                            <Button
                                android:id="@+id/btnClearAiDiagnosis"
                                style="?android:attr/borderlessButtonStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Cerrar aviso"
                                android:textColor="#E65100"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Estado de Conexión y Botón Conectar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Estado Conexión:"
                                android:textColor="#4B5563"
                                android:textSize="14sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <View
                                    android:id="@+id/tvConnectionState"
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:layout_marginEnd="6dp"
                                    android:background="@android:drawable/presence_offline" />

                                <TextView
                                    android:id="@+id/tvConnectionStateText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Desconectado"
                                    android:textColor="#757575"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnConnect"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:backgroundTint="#2E7D32"
                            app:cornerRadius="20dp"
                            android:text="CONECTAR AL DISPOSITIVO"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Barra de Alerta y Riesgo -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#E5E7EB">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvAlerta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Riesgo"
                                android:textColor="#D32F2F"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvLastUpdate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Última actualización: --"
                                android:textColor="#757575"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Tarjeta de Datos actuales -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#F9FAFB">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Datos actuales"
                                    android:textColor="#2E7D32"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvDayNightStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:text="(Día)"
                                    android:textColor="#757575"
                                    android:textSize="13sp" />
                            </RelativeLayout>

                            <GridLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:columnCount="2"
                                android:alignmentMode="alignMargins">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:layout_marginBottom="12dp"
                                    android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Temperatura" android:textSize="13sp" android:textColor="#757575" />
                                    <TextView android:id="@+id/tvTemp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- °C" android:textSize="20sp" android:textStyle="bold" android:textColor="#212121" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:layout_marginBottom="12dp"
                                    android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hum. Ambiente" android:textSize="13sp" android:textColor="#757575" />
                                    <TextView android:id="@+id/tvHum" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- %" android:textSize="20sp" android:textStyle="bold" android:textColor="#212121" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:layout_marginBottom="12dp"
                                    android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hum. Tierra" android:textSize="13sp" android:textColor="#757575" />
                                    <TextView android:id="@+id/tvSoil" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- %" android:textSize="20sp" android:textStyle="bold" android:textColor="#2E7D32" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Luz solar" android:textSize="13sp" android:textColor="#757575" />
                                    <TextView android:id="@+id/tvLuz" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- %" android:textSize="20sp" android:textStyle="bold" android:textColor="#212121" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:layout_columnSpan="2"
                                    android:gravity="center"
                                    android:layout_marginTop="6dp"
                                    android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="IRH" android:textSize="13sp" android:textColor="#757575" />
                                    <TextView android:id="@+id/tvIRH" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="20sp" android:textStyle="bold" android:textColor="#D32F2F" />
                                </LinearLayout>
                            </GridLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Botón de Sistema de Riego -->
                    <Button
                        android:id="@+id/btnWatering"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginBottom="16dp"
                        android:backgroundTint="#2563EB"
                        app:cornerRadius="20dp"
                        android:text="REGISTRAR RIEGO"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />

                    <!-- Tarjeta de predicción -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#F9FAFB">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Predicción"
                                android:textColor="#2E7D32"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tvWateringRecommended"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Riego recomendado: --"
                                    android:textSize="14sp"
                                    android:textColor="#2563EB"
                                    android:textStyle="bold"/>
                                <TextView
                                    android:id="@+id/tvNextWateringTime"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Próximo riego estimado: --"
                                    android:textSize="12sp"
                                    android:textColor="#757575"
                                    android:layout_marginTop="2dp"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:orientation="horizontal">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sequía estimada: " android:textSize="14sp" android:textColor="#757575"/>
                                <TextView android:id="@+id/tvSeq" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- h" android:textStyle="bold" android:textSize="14sp" android:textColor="#212121" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:orientation="horizontal">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sombra necesaria: " android:textSize="14sp" android:textColor="#757575"/>
                                <TextView android:id="@+id/tvSomb" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- h" android:textStyle="bold" android:textSize="14sp" android:textColor="#212121" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="12dp"
                                android:layout_marginBottom="12dp"
                                android:background="#EEEEEE" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Acción:"
                                android:textSize="13sp"
                                android:textColor="#757575" />

                            <TextView
                                android:id="@+id/tvAccion"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="--"
                                android:textColor="#2E7D32"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Tarjeta de gráficas -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="350dp"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="Evolución de sensores"
                                android:textColor="#2E7D32"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <HorizontalScrollView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:scrollbars="none"
                                android:layout_marginBottom="8dp">
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">
                                    <CheckBox android:id="@+id/cbTemp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Temp" android:checked="true" />
                                    <CheckBox android:id="@+id/cbHum" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hum" android:checked="true" />
                                    <CheckBox android:id="@+id/cbSoil" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Suelo" android:checked="true" />
                                    <CheckBox android:id="@+id/cbLuz" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Luz" android:checked="true" />
                                    <CheckBox android:id="@+id/cbIRH" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="IRH" android:checked="true" />
                                </LinearLayout>
                            </HorizontalScrollView>

                            <com.github.mikephil.charting.charts.CombinedChart
                                android:id="@+id/combinedChart"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Gestión de Planta -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#F0F0F0">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Control de registros de datos"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#616161"
                                android:layout_marginStart="16dp"
                                android:layout_marginBottom="4dp"/>

                            <Button
                                android:id="@+id/btnDataControl"
                                style="?android:attr/borderlessButtonStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Importar | Reiniciar | Eliminar"
                                android:textColor="#2E7D32"
                                android:textStyle="bold"
                                android:gravity="start|center_vertical"
                                android:paddingStart="16dp" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#DDDDDD"
                                android:layout_marginStart="12dp"
                                android:layout_marginEnd="12dp" />

                            <Button
                                android:id="@+id/btnDeletePlant"
                                style="?android:attr/borderlessButtonStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Eliminar Planta"
                                android:textColor="#D32F2F"
                                android:textStyle="bold"
                                android:gravity="start|center_vertical"
                                android:paddingStart="16dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </ScrollView>
        </androidx.cardview.widget.CardView>

        <!-- 3. Barra de navegación inferior flotante con efecto Gooey (Compose) -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/composeBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</FrameLayout>
