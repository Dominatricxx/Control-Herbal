// secrets.h  --  COPIA este archivo a "secrets.h" y rellena tus datos.
// secrets.h está en .gitignore: NO lo subas al repositorio.

// ---- WiFi (la segunda red es opcional: borra las dos líneas si no la usas)
#define WIFI_SSID_1  "tu_red"
#define WIFI_PASS_1  "tu_password"
#define WIFI_SSID_2  "otra_red"
#define WIFI_PASS_2  "otra_password"

// ---- Firebase
#define FIREBASE_HOST     "https://TU-PROYECTO-default-rtdb.firebaseio.com"
#define FIREBASE_API_KEY  "tu_web_api_key"

// Cuenta de Firebase Auth (correo/contraseña) CREADA SOLO PARA ESTE ESP32.
// Después añade su UID en la base:  /roles/<uid> = "device"
#define FIREBASE_DEVICE_EMAIL     "esp32-sala@tu-dominio.example"
#define FIREBASE_DEVICE_PASSWORD  "una-contraseña-larga-y-unica"

// ---- Certificado raíz para validar TLS (formato PEM).
// Descarga la CA raíz vigente de Google Trust Services (https://pki.goog/repository/),
// normalmente "GTS Root R1", y pégala aquí. Verifica la huella antes de confiar en ella.
#define FIREBASE_ROOT_CA \
"-----BEGIN CERTIFICATE-----\n" \
"PEGA_AQUI_EL_CERTIFICADO_RAIZ_LINEA_A_LINEA\n" \
"-----END CERTIFICATE-----\n"
